{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# SelfSmart - DPO Fine-Tuning on Kaggle GPU\n",
    "\n",
    "This notebook applies Direct Preference Optimization (DPO / RLHF) to your fine-tuned model using user feedback."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q -U torch transformers peft accelerate datasets trl bitsandbytes"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Import Libraries & Check GPU"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
    "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
    "from trl import DPOTrainer, DPOConfig\n",
    "from datasets import Dataset\n",
    "import json\n",
    "import os\n",
    "\n",
    "# Check GPU\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"Using device: {device}\")\n",
    "if device == \"cuda\":\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Load DPO Dataset\n",
    "\n",
    "**🚨 IMPORTANT:** You must upload `dpo_dataset.json` to Kaggle first!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset_path = '/kaggle/input/selfsmart-data'  # <-- CHANGE THIS TO YOUR UPLOADED PATH\n",
    "dpo_file = os.path.join(dataset_path, 'dpo_dataset.json')\n",
    "\n",
    "try:\n",
    "    with open(dpo_file, 'r') as f:\n",
    "        dpo_data = json.load(f)\n",
    "    print(f\"✅ Successfully loaded data! DPO pairs: {len(dpo_data)}\")\n",
    "except FileNotFoundError:\n",
    "    print(\"❌ ERROR: Dataset not found! Make sure you uploaded the data and updated the `dataset_path` variable.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Format Dataset for DPOTrainer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "prompts = []\n",
    "chosen = []\n",
    "rejected = []\n",
    "\n",
    "for item in dpo_data:\n",
    "    p = f\"### Instruction:\\n{item['prompt']}\\n\\n### Assistant:\\n\"\n",
    "    prompts.append(p)\n",
    "    chosen.append(item['chosen'])\n",
    "    rejected.append(item['rejected'])\n",
    "\n",
    "dpo_dataset = Dataset.from_dict({\n",
    "    \"prompt\": prompts,\n",
    "    \"chosen\": chosen,\n",
    "    \"rejected\": rejected\n",
    "})\n",
    "\n",
    "print(f\"Formatted dataset size: {len(dpo_dataset)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Load Base Model and Tokenizer (4-bit)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# If you uploaded your fine-tuned base model from Phase 3, point this to it!\n",
    "# Otherwise, we use the original Phi-3 model.\n",
    "model_name = \"microsoft/Phi-3-mini-4k-instruct\" \n",
    "print(f\"Loading model: {model_name}\")\n",
    "\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type=\"nf4\",\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_use_double_quant=True,\n",
    ")\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)\n",
    "if tokenizer.pad_token is None:\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    model_name,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",\n",
    "    trust_remote_code=True\n",
    ")\n",
    "\n",
    "model = prepare_model_for_kbit_training(model)\n",
    "\n",
    "# Apply LoRA for DPO\n",
    "lora_config = LoraConfig(\n",
    "    r=8,\n",
    "    lora_alpha=16,\n",
    "    lora_dropout=0.05,\n",
    "    target_modules=[\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\"],\n",
    "    bias=\"none\",\n",
    "    task_type=\"CAUSAL_LM\"\n",
    ")\n",
    "\n",
    "model = get_peft_model(model, lora_config)\n",
    "model.print_trainable_parameters()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Train with DPOTrainer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dpo_config = DPOConfig(\n",
    "    output_dir=\"./dpo_checkpoints\",\n",
    "    beta=0.1,  # KL penalty parameter\n",
    "    learning_rate=5e-5,\n",
    "    per_device_train_batch_size=2,\n",
    "    gradient_accumulation_steps=4,\n",
    "    num_train_epochs=3,\n",
    "    max_length=512,\n",
    "    max_prompt_length=256,\n",
    "    optim=\"paged_adamw_32bit\",\n",
    "    remove_unused_columns=False,\n",
    "    logging_steps=5,\n",
    "    save_strategy=\"epoch\",\n",
    ")\n",
    "\n",
    "trainer = DPOTrainer(\n",
    "    model=model,\n",
    "    ref_model=None, # PEFT handles reference natively without duplicating VRAM!\n",
    "    args=dpo_config,\n",
    "    train_dataset=dpo_dataset,\n",
    "    tokenizer=tokenizer,\n",
    ")\n",
    "\n",
    "print(\"🚀 Starting DPO Training...\")\n",
    "trainer.train()\n",
    "print(\"✅ DPO Training complete!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 7: Export DPO Adapters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "output_dir = \"./dpo_final_model\"\n",
    "trainer.save_model(output_dir)\n",
    "tokenizer.save_pretrained(output_dir)\n",
    "\n",
    "import shutil\n",
    "shutil.make_archive(\"dpo_final_model\", \"zip\", output_dir)\n",
    "\n",
    "print(\"✅ `dpo_final_model.zip` is ready for download!\")"
   ]
  }
 ],
