# SmartSelf AI - Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="SmartSelf AI"
ENV=local  # local | staging | production
DEBUG=true
JSON_LOGS=false

# ===========================================
# LLM PROVIDER (chat / generation)
# ===========================================
# gemini | deepseek
LLM_PROVIDER=gemini

# ===========================================
# API KEYS
# ===========================================
GEMINI_API_KEY=your_gemini_key
DEEPSEEK_API_KEY=your_deepseek_key
OPENAI_API_KEY=optional_key

# ===========================================
# SERVER CONFIGURATION
# ===========================================
HOST=0.0.0.0
PORT=8000

# ===========================================
# DATABASE & STORAGE
# ===========================================
DATABASE_URL=sqlite:///./smartself.db
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ===========================================
# LEARNING PIPELINE
# ===========================================
MAX_CONCURRENT_CRAWLS=10
CRAWL_RATE_LIMIT=1
DAILY_CRAWL_LIMIT=1000
MIN_QUALITY_SCORE=0.3

# ===========================================
# SECURITY
# ===========================================
# In production, set this to your specific frontend domain
CORS_ORIGINS=*
SECRET_KEY=generate_a_secure_key_for_production
