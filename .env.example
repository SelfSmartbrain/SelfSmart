# SelfSmart AI - Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="SelfSmart AI"
ENV=local  # local | staging | production
DEBUG=true
JSON_LOGS=false

# ===========================================
# LLM PROVIDER (chat / generation)
# ===========================================
# gemini | deepseek | openrouter
LLM_PROVIDER=gemini

# ===========================================
# API KEYS - REPLACE WITH YOUR OWN KEYS
# ===========================================
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# SECURITY - REQUIRED IN PRODUCTION
# ===========================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_with_python_c_import_secrets_print_secrets_token_hex_32

# In production, set specific domains instead of *
CORS_ORIGINS=*

# ===========================================
# SERVER CONFIGURATION
# ===========================================
HOST=0.0.0.0
PORT=8000

# ===========================================
# DATABASE & STORAGE
# ===========================================
# Development
DATABASE_URL=sqlite:///./smartself.db
# Production (PostgreSQL): postgresql+asyncpg://user:password@localhost/dbname

REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ===========================================
# LEARNING PIPELINE
# ===========================================
MAX_CONCURRENT_CRAWLS=10
CRAWL_RATE_LIMIT=1
DAILY_CRAWL_LIMIT=1000
MIN_QUALITY_SCORE=0.3

# ===========================================
# DOCKER COMPOSE SECRETS
# ===========================================
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=<generate-a-strong-password>
NEO4J_PASSWORD=<generate-a-strong-password>
GRAFANA_PASSWORD=<generate-a-strong-password>