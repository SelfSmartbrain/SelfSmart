# SmartShelf AI Chat Service - Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================================
# LLM PROVIDER (chat / generation)
# ===========================================
# gemini — recommended free tier: create a key at https://aistudio.google.com/apikey
# deepseek — low-cost paid API: https://platform.deepseek.com/
LLM_PROVIDER=gemini

# ===========================================
# API KEYS (set the key for your LLM_PROVIDER)
# ===========================================
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional — only if you integrate OpenAI elsewhere
OPENAI_API_KEY=

# ===========================================
# SERVICE CONFIGURATION
# ===========================================
DEBUG=false
LOG_LEVEL=info
PYTHONPATH=/app

# ===========================================
# PROXY CONFIGURATION (Optional)
# ===========================================
# Uncomment and set if you're behind a corporate proxy
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=https://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1

# ===========================================
# AI/ML CONFIGURATION
# ===========================================
# Embeddings run locally (Sentence Transformers) — no embedding API key required by default
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Vector database configuration
VECTOR_DB_PATH=/app/data/vector_store

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================
# Maximum concurrent requests
MAX_WORKERS=4

# Request timeout in seconds
REQUEST_TIMEOUT=60

# ===========================================
# MONITORING & LOGGING
# ===========================================
# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Enable structured logging
STRUCTURED_LOGGING=true

# ===========================================
# SECURITY
# ===========================================
# CORS origins (comma-separated)
# For production, set specific domains instead of *
CORS_ORIGINS=*

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# DEPLOYMENT SETTINGS
# ===========================================
# Build metadata
BUILD_DATE=2024-01-01T00:00:00Z
VERSION=1.0.0
VCS_REF=latest

# ===========================================
# OPTIONAL EXTERNAL SERVICES
# ===========================================
# Redis cache (if using)
REDIS_URL=redis://localhost:6379/0

# Monitoring (if using)
SENTRY_DSN=
PROMETHEUS_ENABLED=false
